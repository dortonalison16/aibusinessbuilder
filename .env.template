# ── Your private keys live here. This file stays on YOUR computer. Never shared. ──
# The connect page fills these in for you (ask your assistant to "open the connect page").
# (A copy of this becomes ".env" — the real one — once you start connecting things.)
# Leave anything you don't use blank. Comments always go on their OWN line, never after a value.

# Payments (Stripe) — so you can get paid
STRIPE_SECRET_KEY=
# Optional: only deliver for these Stripe products (comma-separated prod_... ids).
# Leave blank if this Stripe account only sells this one product.
STRIPE_PRODUCT_IDS=
# Optional: set to true if your checkout is a GoHighLevel order form (those sales aren't
# "Checkout Sessions" in Stripe). Only use this if this Stripe account sells just this product.
SALES_INCLUDE_OTHER_PAYMENTS=

# Email delivery — so buyers receive your product
# e.g. smtp
EMAIL_PROVIDER=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
# Optional: a download link to email instead of attaching the file (best for big files).
PRODUCT_DOWNLOAD_URL=
# Optional: how delivery emails are signed (default: your business name, or "The team")
EMAIL_SIGN_OFF=

# Telegram reporting — sale pings + weekly digest on your phone (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Auto content-writing (optional) — lets scheduled scripts research + write content unattended.
# Without this, content is written when you're in a session; render + post can still be scheduled.
ANTHROPIC_API_KEY=
# Optional: which Claude model writes unattended (default claude-sonnet-5)
ANTHROPIC_MODEL=

# Social posting (optional) — Facebook Page + Instagram Business account
# Stays in DRY-RUN (preview only) until you set SOCIAL_DRY_RUN=false yourself.
META_PAGE_ID=
META_PAGE_TOKEN=
IG_USER_ID=
SOCIAL_DRY_RUN=true
# Image hosting (needed for Instagram auto-posting — IG can only post from a public URL).
# Free key from imgbb.com. Facebook can post without this.
IMGBB_API_KEY=

# ── Meta ADS (optional) — only needed if you want to run paid traffic ──────────────────
# Your own ad account. Everything your assistant creates is PAUSED; nothing spends until
# you switch it on yourself in Ads Manager. Fill in the Meta ads card on the connect page and you'll be
# walked through getting each of these.
# Ad account id — starts with act_ (from Ads Manager)
META_AD_ACCOUNT_ID=
# System User token with ads_management + ads_read
META_ADS_TOKEN=
# From Events Manager -> Data Sources
META_PIXEL_ID=
# Custom Conversion id for your thank-you page (Events Manager -> Custom Conversions).
# Use this when your pixel only fires PageView.
META_CUSTOM_CONVERSION_ID=
# Targeting + guardrails. Sensible defaults are used if you leave these blank.
# Countries, e.g. US,CA,GB,AU  (default: US,CA,GB,AU)
ADS_COUNTRIES=
# Youngest age to show ads to (default 25)
ADS_AGE_MIN=
# Oldest age to show ads to (default 65)
ADS_AGE_MAX=
# Most you'd pay per lead/result (optional; default 12, in your ad account's currency) — not your product price.
ADS_TARGET_COST_PER_RESULT=
# Won't judge an ad below this spend (default 20) — stops good ads being killed on thin
# data, the most common ads mistake
ADS_MIN_SPEND_BEFORE_JUDGING=
# Spend with zero results before it suggests switching an ad off (default 30)
ADS_KILL_SPEND_NO_RESULT=

# ── Customer-service inbox (optional) — lets your assistant read support email ─────────
# It DRAFTS replies for you to approve; it never sends to a customer on its own.
# Must be an APP PASSWORD, not your normal password (Google needs 2-Step Verification on
# first). Fill in the Gmail card on the connect page and you'll be walked through it.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Only change these for a non-Gmail inbox (defaults: imap.gmail.com and 993)
IMAP_HOST=
IMAP_PORT=

# ── CRM hand-off (optional) — adds each buyer to GoHighLevel and tags them ─────────────
# This is what makes your onboarding emails start automatically the moment someone buys,
# instead of you remembering to add them. Sales and delivery work fine without it.
# Both come from Settings -> Private Integrations (contact read+write)
GHL_TOKEN=
GHL_LOCATION_ID=

# Advanced (leave blank): Meta Graph API version used for posting + ads (default v24.0)
META_GRAPH_VERSION=
